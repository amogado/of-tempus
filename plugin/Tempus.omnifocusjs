/*{
	"type": "action",
	"targets": ["omnifocus"],
	"author": "amogado",
	"identifier": "com.amogado.of-tempus",
	"version": "0.1",
	"description": "Start/stop a time entry in Tempus (Toggl v9-compatible) for the selected task. Invoke with no selection to configure.",
	"label": "Tempus: Start / Stop",
	"shortLabel": "Tempus",
	"paletteLabel": "Tempus",
	"image": "timer"
}*/
(() => {
	const prefs = new Preferences();
	const credentials = new Credentials();

	const getConfig = () => {
		const cred = credentials.read("tempus");
		return {
			base: prefs.readString("baseURL") || "",
			workspace: prefs.readString("workspace") || "",
			token: cred ? cred.password : ""
		};
	};

	async function configure() {
		const cfg = getConfig();
		const form = new Form();
		form.addField(new Form.Field.String("base", "URL Tempus", cfg.base || "https://"));
		form.addField(new Form.Field.String("workspace", "Workspace", cfg.workspace || "My Workspace"));
		form.addField(new Form.Field.String("token", "Token API (vide = inchangé)", ""));
		await form.show("Configuration Tempus", "Enregistrer");
		prefs.write("baseURL", String(form.values.base || "").replace(/\/+$/, ""));
		prefs.write("workspace", String(form.values.workspace || ""));
		if (form.values.token) { credentials.write("tempus", "token", String(form.values.token)); }
	}

	async function api(cfg, method, path, body) {
		const req = URL.FetchRequest.fromString(cfg.base + "/api/v9" + path);
		req.method = method;
		req.headers = { "Authorization": "Bearer " + cfg.token, "Content-Type": "application/json" };
		if (body) { req.bodyString = JSON.stringify(body); }
		const resp = await req.fetch();
		if (resp.statusCode === 401) { throw new Error("Token refusé (401). Relance le plug-in sans sélection pour reconfigurer."); }
		if (resp.statusCode >= 300) { throw new Error("Tempus HTTP " + resp.statusCode + " (" + method + " " + path + ")"); }
		const txt = resp.bodyString;
		return txt ? JSON.parse(txt) : null;
	}

	async function getWid(cfg) {
		const wss = await api(cfg, "GET", "/workspaces");
		if (!wss || wss.length === 0) { throw new Error("Aucun workspace Tempus."); }
		const ws = wss.find(w => w.name === cfg.workspace) || wss[0];
		return ws.id;
	}

	async function ensureProject(cfg, wid, clientName, projectName) {
		let cid = null;
		if (clientName) {
			const clients = (await api(cfg, "GET", "/workspaces/" + wid + "/clients")) || [];
			const c = clients.find(x => x.name === clientName);
			cid = c ? c.id : (await api(cfg, "POST", "/workspaces/" + wid + "/clients", { name: clientName })).id;
		}
		const projects = (await api(cfg, "GET", "/workspaces/" + wid + "/projects")) || [];
		const p = projects.find(x => x.name === projectName && (!cid || x.client_id === cid));
		if (p) { return p.id; }
		const body = { name: projectName, active: true };
		if (cid) { body.client_id = cid; }
		return (await api(cfg, "POST", "/workspaces/" + wid + "/projects", body)).id;
	}

	const fmt = secs => {
		const h = Math.floor(secs / 3600), m = Math.floor((secs % 3600) / 60), s = secs % 60;
		return h > 0 ? h + "h" + String(m).padStart(2, "0") : (m > 0 ? m + "m" + String(s).padStart(2, "0") : s + "s");
	};

	const action = new PlugIn.Action(async function (selection) {
		try {
			const task = selection.tasks[0];
			if (!task) { await configure(); return; }

			let cfg = getConfig();
			if (!cfg.base || !cfg.token) {
				await configure();
				cfg = getConfig();
				if (!cfg.base || !cfg.token) { return; }
			}

			const cur = await api(cfg, "GET", "/me/time_entries/current");

			if (cur && cur.description === task.name) {
				const wid = cur.workspace_id || (await getWid(cfg));
				await api(cfg, "PATCH", "/workspaces/" + wid + "/time_entries/" + cur.id + "/stop");
				const secs = Math.max(0, Math.round((Date.now() - new Date(cur.start).getTime()) / 1000));
				await new Alert("⏹ Tempus", task.name + " — " + fmt(secs)).show();
				return;
			}

			const wid = await getWid(cfg);
			if (cur) { await api(cfg, "PATCH", "/workspaces/" + wid + "/time_entries/" + cur.id + "/stop"); }

			const project = task.containingProject;
			const clientName = project && project.parentFolder ? project.parentFolder.name : "";
			const projectName = project ? project.name : "Inbox";
			const pid = await ensureProject(cfg, wid, clientName, projectName);
			const body = {
				description: task.name,
				workspace_id: wid,
				duration: -1,
				start: new Date().toISOString(),
				created_with: "of-tempus-plugin"
			};
			if (pid) { body.project_id = pid; }
			await api(cfg, "POST", "/workspaces/" + wid + "/time_entries", body);
			await new Alert("▶️ Tempus", "[" + (clientName || "—") + " / " + projectName + "] " + task.name).show();
		} catch (err) {
			new Alert("Tempus — erreur", String((err && err.message) || err)).show();
		}
	});

	// Toujours invocable : sans sélection, ouvre la configuration.
	action.validate = function () { return true; };

	return action;
})();
